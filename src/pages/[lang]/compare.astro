---
import Base from '../../layouts/Base.astro';
import Compare from '../../components/Compare';
import { UI } from '../../lib/ui';
import { T } from '../../lib/i18n';
import type { Lang } from '../../lib/types';
export function getStaticPaths() { return [{ params: { lang: 'vi' } }, { params: { lang: 'en' } }]; }
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={T[lang].cmpH} path="compare" active="compare">
  <div class="wrap view">
    <div class="sec-h"><h1 style="font-size:2rem">{T[lang].cmpH}</h1></div>
    <Compare client:load lang={lang} />
  </div>
</Base>
